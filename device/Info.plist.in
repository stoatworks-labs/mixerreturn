<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>          <string>en</string>
    <key>CFBundleExecutable</key>                 <string>MixerReturn</string>
    <key>CFBundleIdentifier</key>                 <string>com.allansargeant.mixerreturn.driver</string>
    <key>CFBundleInfoDictionaryVersion</key>      <string>6.0</string>
    <key>CFBundleName</key>                       <string>MixerReturn</string>
    <key>CFBundlePackageType</key>                <string>BNDL</string>
    <key>CFBundleShortVersionString</key>         <string>@MIXERRETURN_VERSION@</string>
    <key>CFBundleVersion</key>                    <string>@MIXERRETURN_VERSION@</string>
    <key>NSHumanReadableCopyright</key>           <string>MIT licence</string>

    <!-- Generate this with uuidgen; never hand-write it. A hand-invented UUID was
         rejected outright by CFBundleCreate here - the bundle became unreadable, so
         coreaudiod could not even look at it, and the device simply never appeared.
         mrprobe catches that in a second without a root install.

         How coreaudiod finds the driver. The factory UUID is this bundle's own, generated
         once and never changed: it is the identity the HAL caches, so a new one on an
         existing install looks like a different driver. The type UUID is Apple's, and is
         the same for every AudioServerPlugIn in existence. -->
    <key>CFPlugInFactories</key>
    <dict>
        <key>D5B372C2-CDFD-4C3B-BDFD-FEBE8D42B643</key>
        <string>MixerReturnCreate</string>
    </dict>
    <key>CFPlugInTypes</key>
    <dict>
        <key>443ABAB8-E7B3-491A-B985-BEB9187030DB</key>
        <array>
            <string>D5B372C2-CDFD-4C3B-BDFD-FEBE8D42B643</string>
        </array>
    </dict>
</dict>
</plist>
